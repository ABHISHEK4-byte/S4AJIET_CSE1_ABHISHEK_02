import java.util.HashSet;

public class Main {
    public static void main(String[] args) {
       
        HashSet<Integer> ai = new HashSet<>();
        ai.add(2);
        ai.add(20);
        ai.add(100);
        System.out.println(ai);
        ai.remove(25);
        System.out.println(ai);
        System.out.println(ai.contains(100));
        System.out.println(ai.size());
        ai.clear();
        System.out.println(ai);
    }
}
