class Main {
    public static void main(String[] args) {
        int n=20,k=2,j=3,m=12,p=12,a,b,c,d;
         if(n<=0||k<=0||j<=0||m<0||p<0){
            System.out.println("Invalid input");
            return;
        }
        a=m/k;
        if(m%k!=0) 
            a++;
        b = p/j;
        if(p%j!=0)
            b++;
        c=a+b;
        d=n-c;
        System.out.println("Number of monkeys left on the tree:"+d);
    }
}
